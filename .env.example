# Sparko environment variables. Copy to .env.local (never commit real values).

# Anthropic API key for live answers. Without it the chat works in a clearly labeled
# limited (deterministic) mode: product lookup, saving, recipes and leaflet still work.
ANTHROPIC_API_KEY=

# Model id. claude-haiku-4-5 = fastest for the demo (default).
# claude-sonnet-5-5 = higher quality, a bit slower.
AI_MODEL=claude-haiku-4-5

# Durable rate limit for live AI (Upstash Redis REST, 20 live requests / 10 min per IP).
# In production (NODE_ENV=production) live AI stays DISABLED until both are set,
# unless ALLOW_UNLIMITED_AI=true. Deterministic answers always work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to true only for private deployments where an unlimited live AI is acceptable.
ALLOW_UNLIMITED_AI=false

# Individual reviewer access (required: without these nobody can sign in). See docs/ACCESS.md.
# Durable account/session store: Upstash Redis REST. The Vercel Marketplace integration sets the
# KV_REST_API_URL / KV_REST_API_TOKEN names, which are accepted instead of UPSTASH_REDIS_REST_*
# (the UPSTASH_* pair above is shared with the AI rate limit).
#KV_REST_API_URL=
#KV_REST_API_TOKEN=
# >= 32 random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SPARKO_AUTH_SECRET=
# Optional: public https URL of the deployment (used for activation links).
SPARKO_PUBLIC_URL=
# Optional: key namespace in the store (default sparko:v2:). Use a different one for tests/staging.
SPARKO_STORE_PREFIX=
